# Antigravity API key placeholder for the local bridge (any non-empty string).
# The bridge itself authenticates to Google via OAuth — this value only
# satisfies Hermes' generic api_key-provider wiring.
ANTIGRAVITY_API_KEY=antigravity-local-token

# Optional overrides (rarely needed):
# HERMES_ANTIGRAVITY_CLIENT_ID=
# HERMES_ANTIGRAVITY_CLIENT_SECRET=
# HERMES_ANTIGRAVITY_PROJECT_ID=

# Only needed if you ran `manage.py setup --groq-model ...` to add Groq Cloud
# as a fallback hop. Hermes has no built-in "groq" provider — it derives this
# key automatically from the api.groq.com host on the fallback entry's
# base_url, so just setting it here is enough; nothing else to configure.
# GROQ_API_KEY=
