{
  "name": "obs-manga-capture",
  "version": "2.0.0",
  "description": "OBS-based automatic manga capture and transcription system using Ollama + LLaVA (12-Factor Agents principles)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "capture": "tsx src/index.ts capture",
    "process": "tsx src/index.ts process",
    "server": "tsx src/server.ts",
    "build": "tsc",
    "test": "jest",
    "ollama:check": "ollama list",
    "ollama:pull": "ollama pull llava:7b",
    "ollama:pull:hd": "ollama pull llava:13b",
    "ollama:pull:light": "ollama pull bakllava",
    "setup": "npm install && npm run ollama:check"
  },
  "dependencies": {
    "tsx": "^4.15.0",
    "typescript": "^5.0.0",
    "sharp": "^0.33.0",
    "chokidar": "^3.5.3",
    "obs-websocket-js": "^5.0.3",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "keywords": [
    "obs",
    "manga",
    "ocr",
    "ollama",
    "llava",
    "vision-llm",
    "windows",
    "12-factor-agents",
    "local-ai"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ]
}
