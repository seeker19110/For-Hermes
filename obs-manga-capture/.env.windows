# ============================================
# Windows + Ollama + Qwen2-VL 環境設定
# ============================================

# Ollama設定
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen2-vl:7b
# 軽量版を使う場合: qwen2-vl:2b

# OBS WebSocket設定（OBSを使う場合）
OBS_WEBSOCKET_URL=ws://localhost:4455
OBS_WEBSOCKET_PASSWORD=

# キャプチャ設定（Windowsパス形式）
CAPTURE_DIR=.\captures
OUTPUT_DIR=.\output
CAPTURE_INTERVAL_MS=1000

# ページ検知設定
IMAGE_SIMILARITY_THRESHOLD=0.85
PAGE_CHANGE_THRESHOLD=0.15

# Qwen2-VL パラメータ
QWEN_TEMPERATURE=0.3
QWEN_NUM_CTX=4096

# パフォーマンス設定
# GPU使用（NVIDIA GPU搭載PCの場合）
USE_GPU=true

# 並列処理数（バッチ処理時）
MAX_CONCURRENT=1

# デバッグ設定
DEBUG=true
LOG_LEVEL=info
VERBOSE=true

# Windows固有設定
# PowerShellスクリーンショット（OBS未使用時）
USE_POWERSHELL_CAPTURE=true
SCREENSHOT_QUALITY=100

# セッション設定
SESSION_AUTO_SAVE=true
SESSION_SAVE_INTERVAL=5

# ============================================
# 推奨設定（Windows 10/11）
# ============================================
#
# CPU環境:
#   OLLAMA_MODEL=qwen2-vl:2b
#   QWEN_NUM_CTX=2048
#   CAPTURE_INTERVAL_MS=2000
#
# GPU環境（NVIDIA）:
#   OLLAMA_MODEL=qwen2-vl:7b
#   USE_GPU=true
#   CAPTURE_INTERVAL_MS=1000
#
# 低スペックPC:
#   OLLAMA_MODEL=qwen2-vl:2b
#   QWEN_NUM_CTX=2048
#   CAPTURE_INTERVAL_MS=3000
#   MAX_CONCURRENT=1
#
# ============================================
