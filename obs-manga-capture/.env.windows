# ============================================
# Windows + Ollama + LLaVA 環境設定（修正版）
# ============================================

# Ollama設定
OLLAMA_API_URL=http://localhost:11434

# ✅ 正しいモデル名（Ollama公式サポート）
OLLAMA_MODEL=llava:7b
# その他の選択肢:
# OLLAMA_MODEL=llava:13b          # 高性能版（8GB）
# OLLAMA_MODEL=llama3.2-vision:11b  # 最新版（7.9GB）
# OLLAMA_MODEL=bakllava            # 軽量版（4.7GB）

# ❌ 以下は使用不可（確認されていない）
# OLLAMA_MODEL=qwen2-vl:7b  # 存在しない可能性
# OLLAMA_MODEL=qwen2-vl:2b  # 存在しない可能性

# OBS WebSocket設定（OBSを使う場合）
OBS_WEBSOCKET_URL=ws://localhost:4455
OBS_WEBSOCKET_PASSWORD=

# キャプチャ設定（Windowsパス形式）
CAPTURE_DIR=.\captures
OUTPUT_DIR=.\output
CAPTURE_INTERVAL_MS=1000

# ページ検知設定
IMAGE_SIMILARITY_THRESHOLD=0.85
PAGE_CHANGE_THRESHOLD=0.15

# Ollama LLM パラメータ
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=4096

# パフォーマンス設定

# GPU使用（NVIDIA GPU搭載PCの場合）
# Ollamaが自動検出するため、通常は設定不要
USE_GPU=true

# 並列処理数（バッチ処理時）
MAX_CONCURRENT=1

# デバッグ設定
DEBUG=true
LOG_LEVEL=info
VERBOSE=true

# Windows固有設定

# PowerShellスクリーンショット（OBS未使用時）
USE_POWERSHELL_CAPTURE=true
SCREENSHOT_QUALITY=100

# セッション設定
SESSION_AUTO_SAVE=true
SESSION_SAVE_INTERVAL=5

# ============================================
# 推奨設定（Windows 10/11）
# ============================================
#
# 🟢 GPU環境（NVIDIA RTX/GTX）:
#   OLLAMA_MODEL=llava:13b
#   OLLAMA_NUM_CTX=4096
#   CAPTURE_INTERVAL_MS=1000
#   → 性能: 1-2秒/ページ
#
# 🟡 GPU環境（低VRAM）:
#   OLLAMA_MODEL=llava:7b
#   OLLAMA_NUM_CTX=4096
#   CAPTURE_INTERVAL_MS=1000
#   → 性能: 1.5-3秒/ページ
#
# 🟠 CPU環境（高性能）:
#   OLLAMA_MODEL=llava:7b
#   OLLAMA_NUM_CTX=2048
#   CAPTURE_INTERVAL_MS=2000
#   → 性能: 5-10秒/ページ
#
# 🔴 低スペックPC:
#   OLLAMA_MODEL=bakllava
#   OLLAMA_NUM_CTX=2048
#   CAPTURE_INTERVAL_MS=3000
#   → 性能: 8-15秒/ページ
#
# ============================================

# ============================================
# セットアップ手順
# ============================================
#
# 1. Ollama for Windows をインストール
#    https://ollama.ai/download/windows
#
# 2. モデルをダウンロード
#    ollama pull llava:7b
#
# 3. Ollamaが起動しているか確認
#    ollama list
#
# 4. このファイルを .env にコピー
#    copy .env.windows.fixed .env
#
# 5. 必要に応じて OLLAMA_MODEL を変更
#
# 6. テスト実行
#    npm run dev capture --no-obs
#
# ============================================
