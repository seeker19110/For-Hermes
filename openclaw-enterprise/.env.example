# OpenClaw Enterprise - Variables environment template
# Скопируйте этот файл в .env и заполните значения

# === LoyalFans Configuration ===
LOYALFANS_USERNAME=your_username
LOYALFANS_PASSWORD=your_password
LOYALFANS_API_KEY=your_api_key

# === Proxy Configuration ===
PROXY_URL=http://username:password@proxy-host:port
PROXY_ENABLED=false

# === OpenRouter (Kimi K2.5) ===
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=kimi-k2.5

# === Whisper Local ===
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# === MCP Servers ===
MCP_BROWSERACT_PORT=3001
MCP_WHISPER_PORT=3002

# === Security ===
ENCRYPTION_KEY=your_32_char_encryption_key
SESSION_SECRET=your_session_secret

# === Database (optional) ===
DATABASE_URL=postgresql://user:pass@localhost:5432/openclaw
REDIS_URL=redis://localhost:6379

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=./logs/openclaw.log
